  "keyFeatures": [
    "Live HLS radio streaming from Radio América 90.9 FM",
    "On-demand video player supporting YouTube, Instagram, HLS (.m3u8) and direct MP4",
    "Podcast/audio player with vinyl fullscreen mode and Spotify/Zeno.fm embed support",
    "Programs and podcasts catalog with episode management",
    "Shorts & Reels vertical video feed with inline playback",
    "Hero carousel with featured and live content",
    "Admin CMS dashboard (videos, programs, sponsors, analytics, profile)",
    "Sponsor ad playlist injection for podcast episodes",
    "Newsletter subscription via REST API",
    "Light/dark mode with localStorage persistence",
    "Docker + Nginx production deployment",
    "Firebase Analytics and Sentry + Mixpanel monitoring"
  ],
  "publicApiSurface": [
    "GET /api/videos",
    "POST /api/videos",
    "PUT /api/videos/:id",
